# Copy to .env (never commit .env).

# --- App (safe to ship in the bundle) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public Mapbox token (pk.*). Leave empty to use the free OpenStreetMap fallback on web.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Google Sheet web app for /join sign-ups on the demo site (see docs/waitlist/README.md).
EXPO_PUBLIC_WAITLIST_URL=

# --- Build / server only (NEVER in the app bundle) ---
# Mapbox secret download token (sk.*), used by native builds.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
# Supabase service role key; used by the importer and Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=
